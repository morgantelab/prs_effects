# ========= 2) Scenario/rep: select causal SNPs + simulate effects =========
rule select_causal_and_effects:
    input:
        # (only input may be a function in your Snakemake)
        bim_list = expand(f"{OUT_DIR}/filtered/ukb_chr{{c}}_filtered.bim", c=CHRS)
    output:
        # use literal patterns with wildcards, NOT lambdas
        causal_table = f"{OUT_DIR}/{{scen}}/rep{{rep}}/pheno/causal_snps.txt",
        causal_ids   = f"{OUT_DIR}/{{scen}}/rep{{rep}}/pheno/causal_snps_IDs.txt",
        true_effects = f"{OUT_DIR}/{{scen}}/rep{{rep}}/pheno/true_effects.txt"
    threads: THREADS_PLK  # or config["THREADS_R"]
    run:
        # compute all dynamic params here (no lambda in params!)
        scen = str(wildcards.scen)
        rep  = int(wildcards.rep)

        seed = 1000 + rep   # your “w.rep + 1000” logic
        n_add    = int(config["SCENARIOS"][scen]["N_ADD"])
        n_comdom = int(config["SCENARIOS"][scen]["N_COMDOM"])

        code = f"{CODE_DIR}/causal_loci_selection.R"

        # make dirs
        import os
        os.makedirs(os.path.dirname(output.causal_table), exist_ok=True)

        shell(r"""
            module load R/4.2.3
            Rscript {code} \
              {OUT_DIR}/filtered \
              {output.causal_table} \
              {output.causal_ids} \
              {output.true_effects} \
              {seed} \
              {n_add} \
              {n_comdom}
            module unload R/4.2.3
        """)

