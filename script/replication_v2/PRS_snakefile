# ========= 5) GWAS per chr on training =========
rule gwas_chr:
    input:
        bed         = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.bed",
        bim         = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.bim",
        fam         = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.fam",
        train_pheno = lambda w: f"{rep_dir(w.scen,w.rep)}/pheno/training_pheno.txt",
        train_ids   = lambda w: f"{rep_dir(w.scen,w.rep)}/pheno/training_IDs.txt"
    output:
        gwas = f"{OUT_DIR}/{{scen}}/rep{{rep}}/gwas/gwas_chr{{chr}}.{config['PHENO_NAME']}.glm.linear"
    params:
        bfile_pref = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered",
        pheno_name = config['PHENO_NAME'],
        outpref    = f"{OUT_DIR}/{{scen}}/rep{{rep}}/gwas/gwas_chr{{chr}}",   # prefix for PLINK2 --out
        threads    = THREADS_PLK
    threads: THREADS_PLK
    shell:
        r"""
        mkdir -p $(dirname {output.gwas})
        {PLINK2} \
          --bfile {params.bfile_pref} \
          --pheno {input.train_pheno} \
          --keep {input.train_ids} \
          --glm no-x-sex allow-no-covars omit-ref \
          --no-input-missing-phenotype \
          --pheno-name {params.pheno_name} \
          --out {params.outpref} \
          --threads {params.threads}
        """


rule gwas_merge:
    input:
        # all per-chr GWAS files across scenarios × reps
        [f"{rep_dir(s, r)}/gwas/gwas_chr{c}.{config['PHENO_NAME']}.glm.linear"
         for s in SCENARIOS for r in range(1, N_REPS + 1) for c in CHRS]
    output:
        # one merged file per scenario × rep
        [f"{rep_dir(s, r)}/gwas/gwas_merged.linear"
         for s in SCENARIOS for r in range(1, N_REPS + 1)]
    run:
        import os, pandas as pd
        for s in SCENARIOS:
            for r in range(1, N_REPS + 1):
                out = f"{rep_dir(s, r)}/gwas/gwas_merged.linear"
                os.makedirs(os.path.dirname(out), exist_ok=True)
                files = [f"{rep_dir(s, r)}/gwas/gwas_chr{c}.{config['PHENO_NAME']}.glm.linear" for c in CHRS]
                files = [f for f in files if os.path.exists(f)]
                assert files, f"No GWAS files for {s} rep{r}"
                with open(out, "w") as fout:
                    first = True
                    for f in files:
                        with open(f) as fin:
                            hdr = fin.readline()
                            if first:
                                fout.write(hdr); first = False
                            for line in fin:
                                fout.write(line)

# ========= 6) Clumping =========
rule clump_chr:
    input:
        bed        = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.bed",
        bim        = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.bim",
        fam        = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.fam",
        train_ids  = lambda w: f"{OUT_DIR}/{w.scen}/rep{w.rep}/pheno/training_IDs.txt",
        gwas_merge = lambda w: f"{OUT_DIR}/{w.scen}/rep{w.rep}/gwas/gwas_merged.linear"
    output:
        clumps = f"{OUT_DIR}/{{scen}}/rep{{rep}}/clump/clump_chr{{chr}}.clumps"
    params:
        bfile_pref = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered",
        clump_dir  = lambda w: f"{OUT_DIR}/{w.scen}/rep{w.rep}/clump",
        sumfile    = lambda w: f"{OUT_DIR}/{w.scen}/rep{w.rep}/clump/gwas_for_clump_chr{w.chr}.txt",
        outprefix  = lambda w: f"{OUT_DIR}/{w.scen}/rep{w.rep}/clump/clump_chr{w.chr}",
        P1 = config['CLUMP_P1'],
        R2 = config['CLUMP_R2'],
        KB = config['CLUMP_KB']
    threads: 2
    shell:
        """
        set -euo pipefail

        mkdir -p {params.clump_dir}

        # Build a 2-col file with header 'ID\\tP' for this chromosome, TEST=='ADD'
        # Column map from your header:
        #   $1=#CHROM, $3=ID, $10=TEST, $15=P
        awk -v c={wildcards.chr} 'BEGIN{{OFS="\\t"; print "ID","P"}} NR>1 && $1==c && $10=="ADD" {{print $3,$15}}' \
            {input.gwas_merge} > {params.sumfile}

        {PLINK2} \
          --bfile {params.bfile_pref} \
          --keep {input.train_ids} \
          --clump {params.sumfile} \
          --clump-snp-field ID --clump-field P \
          --clump-p1 {params.P1} --clump-r2 {params.R2} --clump-kb {params.KB} \
          --out {params.outprefix}

        # Ensure expected output exists even if PLINK2 reports 'No significant --clump results'
        if [ ! -f "{output.clumps}" ]; then
          : > "{output.clumps}"
        fi
        """


rule clump_merge:
    input:
        [f"{rep_dir(s, r)}/clump/clump_chr{c}.clumps"
         for s in SCENARIOS for r in range(1, N_REPS + 1) for c in CHRS]
    output:
        [f"{rep_dir(s, r)}/clump/clumped_snps.snplist"
         for s in SCENARIOS for r in range(1, N_REPS + 1)]
    run:
        import os
        for s in SCENARIOS:
            for r in range(1, N_REPS + 1):
                clumps = [f"{rep_dir(s, r)}/clump/clump_chr{c}.clumps" for c in CHRS]
                ids = []
                for f in clumps:
                    if os.path.exists(f) and os.path.getsize(f) > 0:
                        with open(f) as fin:
                            next(fin, None)
                            for line in fin:
                                if line.strip():
                                    ids.append(line.split()[2])
                ids = sorted(set(ids))
                out = f"{rep_dir(s, r)}/clump/clumped_snps.snplist"
                os.makedirs(os.path.dirname(out), exist_ok=True)
                with open(out, "w") as fout:
                    for x in ids:
                        fout.write(x + "\n")

# ========= 7) PRS_beta on testing =========
rule make_beta_weights:
    input:
        gwas_merge = lambda w: f"{rep_dir(w.scen,w.rep)}/gwas/gwas_merged.linear",
        snplist    = lambda w: f"{rep_dir(w.scen,w.rep)}/clump/clumped_snps.snplist"
    output:
        weights = f"{OUT_DIR}/{{scen}}/rep{{rep}}/score/beta_for_score.clumped.txt"
    run:
        import pandas as pd, os
        os.makedirs(f"{rep_dir(wildcards.scen,wildcards.rep)}/score", exist_ok=True)
        g = pd.read_csv(input.gwas_merge, sep='\t')
        if '#CHROM' in g.columns: g = g.rename(columns={'#CHROM':'CHR'})
        if 'TEST' in g.columns:   g = g[g['TEST']=='ADD']
        idx = set(pd.read_csv(input.snplist, header=None)[0])
        g = g[g['ID'].isin(idx)][['ID','A1','BETA']]
        g.to_csv(output.weights, sep='\t', index=False)

rule score_beta_chr:
    input:
        bed      = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.bed",
        bim      = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.bim",
        fam      = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.fam",
        test_ids = lambda w: f"{OUT_DIR}/{w.scen}/rep{w.rep}/pheno/testing_IDs.txt",
        weights  = lambda w: f"{OUT_DIR}/{w.scen}/rep{w.rep}/score/beta_for_score.clumped.txt"
    output:
        sscore   = f"{OUT_DIR}/{{scen}}/rep{{rep}}/score/score_clumped_chr{{chr}}.sscore"
    params:
        bfile_pref  = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered",
        score_dir   = lambda w: f"{OUT_DIR}/{w.scen}/rep{w.rep}/score",
        outprefix   = lambda w: f"{OUT_DIR}/{w.scen}/rep{w.rep}/score/score_clumped_chr{w.chr}",
        weights_chr = lambda w: f"{OUT_DIR}/{w.scen}/rep{w.rep}/score/beta_for_score.clumped.chr{w.chr}.txt"
    threads: 4
    shell:
        """
        set -euo pipefail
        mkdir -p "{params.score_dir}"

        # 从 BIM 的第2列收集本染色体ID；保留权重文件表头（FNR==1）
        awk 'NR==FNR{{ids[$2]=1; next}} FNR==1 || ($1 in ids)' \
            {input.bim} {input.weights} > "{params.weights_chr}"

        # 若该染色体没有任何 clumped SNP，生成全0的 .sscore，列名固定为 IID / BETA_SUM
        if [ "$(wc -l < "{params.weights_chr}")" -le 1 ]; then
          awk 'BEGIN{{OFS="\\t"; print "IID","BETA_SUM"}} {{print $2,0}}' {input.test_ids} > "{output.sscore}"
        else
          {PLINK2} \
            --bfile {params.bfile_pref} \
            --keep {input.test_ids} \
            --score {params.weights_chr} 1 2 3 header-read cols=+scoresums \
            --out {params.outprefix}
        fi
        """

