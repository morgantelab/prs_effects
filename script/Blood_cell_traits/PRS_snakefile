rule gwas_merge:
    input:
        # all per-chr GWAS files across scenarios × reps
        [f"{rep_dir(s, r)}/gwas/gwas_chr{c}.{config['PHENO_NAME']}.glm.linear"
         for s in SCENARIOS for r in range(1, N_REPS + 1) for c in CHRS]
    output:
        # one merged file per scenario × rep
        [f"{rep_dir(s, r)}/gwas/gwas_merged.linear"
         for s in SCENARIOS for r in range(1, N_REPS + 1)]
    run:
        import os, pandas as pd
        for s in SCENARIOS:
            for r in range(1, N_REPS + 1):
                out = f"{rep_dir(s, r)}/gwas/gwas_merged.linear"
                os.makedirs(os.path.dirname(out), exist_ok=True)
                files = [f"{rep_dir(s, r)}/gwas/gwas_chr{c}.{config['PHENO_NAME']}.glm.linear" for c in CHRS]
                files = [f for f in files if os.path.exists(f)]
                assert files, f"No GWAS files for {s} rep{r}"
                with open(out, "w") as fout:
                    first = True
                    for f in files:
                        with open(f) as fin:
                            hdr = fin.readline()
                            if first:
                                fout.write(hdr); first = False
                            for line in fin:
                                fout.write(line)

# ========= 6) Clumping =========
wildcard_constraints:
    p=".+", r2=".+"

rule clump_chr:
    input:
        bed        = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.bed",
        bim        = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.bim",
        fam        = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.fam",
        train_ids  = lambda w: f"{rep_dir(w.scen,w.rep)}/pheno/training_IDs.txt",
        gwas_merge = lambda w: f"{rep_dir(w.scen,w.rep)}/gwas/gwas_merged.linear"
    output:
        clumps = f"{GRID_PREFIX}/clump/clump_chr{{chr}}.clumps"
    params:
        bfile_pref = f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered",
        clump_dir  = f"{GRID_PREFIX}/clump",
        sumfile    = f"{GRID_PREFIX}/clump/gwas_for_clump_chr{{chr}}.txt",
        outprefix  = f"{GRID_PREFIX}/clump/clump_chr{{chr}}",
        KB = KB
    threads: 4
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.clump_dir}"

        # Build 'ID\tP' for this chr, only TEST=='ADD' (columns from lm-based .glm.linear)
        awk -v c={wildcards.chr} 'BEGIN{{OFS="\t"; print "ID","P"}} NR>1 && $1==c && $7=="ADD" {{print $3,$12}}' \
            {input.gwas_merge} > "{params.sumfile}"

        {PLINK2} \
          --bfile {params.bfile_pref} \
          --keep {input.train_ids} \
          --clump {params.sumfile} \
          --clump-snp-field ID --clump-field P \
          --clump-p1 {wildcards.p} --clump-r2 {wildcards.r2} --clump-kb {params.KB} \
          --out {params.outprefix}

        [ -f "{output.clumps}" ] || : > "{output.clumps}"
        """

rule clump_merge:
    input:
        clumps = lambda w: [f"{OUT_DIR}/{w.scen}/rep{w.rep}/grid/p{w.p}_r{w.r2}/clump/clump_chr{c}.clumps" for c in CHRS]
    output:
        snplist = f"{GRID_PREFIX}/clump/clumped_snps.snplist"
    run:
        import os
        os.makedirs(os.path.dirname(output.snplist), exist_ok=True)
        ids = []
        for c in CHRS:
            f = f"{OUT_DIR}/{wildcards.scen}/rep{wildcards.rep}/grid/p{wildcards.p}_r{wildcards.r2}/clump/clump_chr{c}.clumps"
            if os.path.exists(f) and os.path.getsize(f) > 0:
                with open(f) as fin:
                    next(fin, None)
                    for line in fin:
                        if line.strip():
                            ids.append(line.split()[2])
        with open(output.snplist, "w") as fout:
            for x in sorted(set(ids)):
                fout.write(x + "\n")


