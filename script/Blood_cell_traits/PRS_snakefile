# ========== Build 20k panel (causals + background) ==========
rule build_gwas_panel:
    input:
        causal_ids = lambda w: f"{OUT_DIR}/{w.scen}/rep{w.rep}/pheno/causal_snps_IDs.txt",
        bims       = expand(f"{OUT_DIR}/filtered/ukb_chr{{c}}_filtered.bim", c=CHRS)
    output:
        panel = f"{OUT_DIR}/{{scen}}/rep{{rep}}/gwas/gwas_panel_{PANEL_SIZE}.snplist"
    params:
        panel_size = PANEL_SIZE,
        panel_seed = PANEL_SEED,
        prop_by_chr= PANEL_PROP_BY_CHR
    run:
        import pandas as pd, numpy as np, os
        os.makedirs(os.path.dirname(output.panel), exist_ok=True)

        caus = pd.read_csv(input.causal_ids, header=None, names=["ID"], sep=r"\s+")
        causal_set = set(caus["ID"].astype(str))

        rows = []
        for bim_fp in input.bims:
            b = pd.read_csv(bim_fp, sep=r"\s+", header=None,
                            names=["CHR","ID","CM","POS","A1","A2"])
            rows.append(b[["CHR","ID"]])
        all_snps = pd.concat(rows, ignore_index=True)
        all_snps["ID"] = all_snps["ID"].astype(str)

        missing = sorted(causal_set - set(all_snps["ID"]))
        assert not missing, f"{len(missing)} causal IDs not found in filtered BIMs."

        bg = all_snps[~all_snps["ID"].isin(causal_set)].copy()
        need_bg = max(0, params.panel_size - len(causal_set))
        assert need_bg > 0, "PANEL_SIZE must exceed number of causal SNPs."

        rng = np.random.default_rng(params.panel_seed)
        if params.prop_by_chr:
            counts = bg["CHR"].value_counts().sort_index()
            alloc = (counts / counts.sum() * need_bg).astype(int)
            while alloc.sum() < need_bg:
                rema = (counts / counts.sum() * need_bg) - alloc
                alloc.loc[rema.idxmax()] += 1
            picks = []
            for c, k in alloc.items():
                pool = bg.loc[bg["CHR"] == c, "ID"].to_numpy()
                if k > 0:
                    k = min(k, len(pool))
                    picks.append(rng.choice(pool, size=k, replace=False))
            picked = np.concatenate(picks) if picks else np.array([], dtype=str)
        else:
            pool = bg["ID"].to_numpy()
            picked = rng.choice(pool, size=need_bg, replace=False)

        panel_ids = pd.Series(sorted(set(list(causal_set) + list(picked))))
        panel_ids.to_csv(output.panel, index=False, header=False)

rule panel_bfile_chr:
    input:
        panel      = lambda w: f"{OUT_DIR}/{w.scen}/rep{w.rep}/gwas/gwas_panel_{PANEL_SIZE}.snplist",
        bed        = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.bed",
        bim        = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.bim",
        fam        = lambda w: f"{OUT_DIR}/filtered/ukb_chr{w.chr}_filtered.fam",
    output:
        bed = f"{OUT_DIR}/{{scen}}/rep{{rep}}/gwas/panel_bfiles/ukb_chr{{chr}}_filtered.bed",
        bim = f"{OUT_DIR}/{{scen}}/rep{{rep}}/gwas/panel_bfiles/ukb_chr{{chr}}_filtered.bim",
        fam = f"{OUT_DIR}/{{scen}}/rep{{rep}}/gwas/panel_bfiles/ukb_chr{{chr}}_filtered.fam"
    params:
        outpref = f"{OUT_DIR}/{{scen}}/rep{{rep}}/gwas/panel_bfiles/ukb_chr{{chr}}_filtered",
        plink2  = PLINK2
    threads: 4
    run:
        import pandas as pd, os, tempfile
        os.makedirs(os.path.dirname(params.outpref), exist_ok=True)

        # 交集：全局 20k IDs ∩ 本染色体 BIM
        panel_ids = pd.read_csv(input.panel, header=None, names=["ID"])["ID"].astype(str)
        bim = pd.read_csv(input.bim, sep=r"\s+", header=None,
                          names=["CHR","ID","CM","POS","A1","A2"])[["ID"]]
        keep = sorted(set(panel_ids).intersection(set(bim["ID"].astype(str))))

        # 写入临时 snplist，然后立刻用 plink2 提取面板 bfile
        if len(keep) == 0:
            # 允许某条染色体恰好没有位点（极少见），写空 snplist 让 plink2 生成空集
            keep_df = pd.Series([], dtype=str)
        else:
            keep_df = pd.Series(keep, dtype=str)

        with tempfile.TemporaryDirectory() as td:
            snpfile = os.path.join(td, "keep.snplist")
            keep_df.to_csv(snpfile, index=False, header=False)

            from snakemake.shell import shell
            shell(r"""
                {params.plink2} \
                  --bfile {OUT_DIR}/filtered/ukb_chr{wildcards.chr}_filtered \
                  --extract {snpfile} \
                  --make-bed \
                  --threads {threads} \
                  --out {params.outpref}
            """)


