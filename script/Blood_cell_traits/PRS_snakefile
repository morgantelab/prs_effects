rule gwas_sig_hits:
    input:
        assoc = lambda wc: f"{OUT_DIR}/kvik/kvik_output.step2.pheno{TRAIT_TO_INDEX[wc.trait]}.assoc"
    output:
        sig   = f"{OUT_DIR}/gwas/{{trait}}/significant.snplist2"
    run:
        import pandas as pd
        import os

        os.makedirs(os.path.dirname(output.sig), exist_ok=True)

        df = pd.read_csv(input.assoc, sep=r"\s+")
        n_snps = df.shape[0]

        # Bonferroni: 5e-8 / number of SNPs
        alpha = 0.05
        thresh = alpha / n_snps
        hits = df[df["Wald_P"] < thresh]
        hits["Predictor"].to_csv(output.sig, index=False, header=False)



rule estimate_ad_real:
    input:
        sig   = f"{OUT_DIR}/gwas/{{trait}}/significant.snplist2",
        pheno = PHENO_CSV,
        covar = COVAR_FILE,
        ids   = ID_LIST
    output:
        ad = f"{OUT_DIR}/effects/{{trait}}_ad.txt"
    params:
        script = f"{CODE_DIR}/estimate_effects.R",
        prefix = f"{OUT_DIR}/filtered/ukb_chr"
    threads: THREADS_R
    shell:
        r"""
        mkdir -p $(dirname {output.ad})

        module load R/4.2.3

        Rscript {params.script} \
            {params.prefix} \
            {input.sig} \
            {input.ids} \
            {input.pheno} \
            {input.covar} \
            {wildcards.trait} \
            {output.ad}

        module unload R/4.2.3
        """

