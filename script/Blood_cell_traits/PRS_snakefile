import os
import yaml

configfile: "PRS_scan_config.yaml"

OUT_DIR      = config["OUT_DIR"]
CODE_DIR     = config["CODE_DIR"]
ID_LIST      = config["ID_list"]
PHENO_CSV    = config["PHENO_CSV"]
COVAR_FILE   = config["COVARIATES"]
PLINK2       = config["PLINK2"]
LDAK         = config["LDAK"]

BED_BIM_DIR  = config["BED_BIM_DIR"]
FAM_DIR      = config["FAM_DIR"]
TRAITS       = config["PHENO_NAMES"]

MAF          = config["MAF"]
MAC          = config["MAC"]
GENO         = config["GENO"]
HWE          = config["HWE"]

PHENO_NAMES  = config["PHENO_NAMES"]
THREADS_PLK  = int(config["THREADS_PLINK"])
THREADS_R    = int(config["THREADS_R"])

DOM_PTHRESH  = float(config["DOM_PTHRESH"])
CHRS         = list(map(int, config["CHRS"]))

# ========= TARGETS =========
rule all:
    input:
        expand(
            f"{OUT_DIR}/gwas/{{trait}}/chr{{chr}}.{{trait}}.assoc.singlesnp",
            trait = TRAITS,
            chr   = CHRS
        )
# ========= 1) Filter bfiles per chromosome =========
rule filter_chr:
    input:
        bed = lambda w: f"{BED_BIM_DIR}/ukb22418_c{w.chr}_b0_v2_s488243.bed",
        bim = lambda w: f"{BED_BIM_DIR}/ukb22418_c{w.chr}_b0_v2_s488243.bim",
        fam = lambda w: f"{FAM_DIR}/ukb22418_c{w.chr}_b0_v2_s487945.fam",
        keep = ID_LIST
    output:
        bed = f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.bed",
        bim = f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.bim",
        fam = f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.fam"
    threads: THREADS_PLK
    params:
        maf = MAF,
        mac = MAC,
        geno = GENO,
        hwe = HWE
    shell:
        r"""
        mkdir -p {OUT_DIR}/filtered

        {PLINK2} \
          --bed {input.bed} \
          --bim {input.bim} \
          --fam {input.fam} \
          --keep {input.keep} \
          --snps-only just-acgt \
          --rm-dup exclude-all \
          --maf {params.maf} \
          --mac {params.mac} \
          --geno {params.geno} \
          --hwe {params.hwe} \
          --threads {threads} \
          --make-bed \
          --out {OUT_DIR}/filtered/ukb_chr{wildcards.chr}_filtered
        """

rule merge_chromosomes:
    input:
        bed = expand(f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.bed", chr=CHRS),
        bim = expand(f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.bim", chr=CHRS),
        fam = expand(f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.fam", chr=CHRS)
    output:
        bed = f"{OUT_DIR}/merged/ukb_merged.bed",
        bim = f"{OUT_DIR}/merged/ukb_merged.bim",
        fam = f"{OUT_DIR}/merged/ukb_merged.fam"
    threads: THREADS
    shell:
        r"""
        mkdir -p {OUT_DIR}/merged

        # prepare merge list file
        MERGE_LIST={OUT_DIR}/merged/merge_list.txt
        rm -f $MERGE_LIST
        # skip chr1 (base), add chr2–22 to merge list
        for c in {",".join(map(str, CHRS[1:]))}; do
            echo "{OUT_DIR}/filtered/ukb_chr$c_filtered" >> $MERGE_LIST
        done

        # merge with plink2
        {PLINK2} \
            --bfile {OUT_DIR}/filtered/ukb_chr1_filtered \
            --merge-list $MERGE_LIST \
            --make-bed \
            --out {OUT_DIR}/merged/ukb_merged
        """

# ========= 2) GWAS  =========
rule kvik_step1:
    input:
        bed   = f"{OUT_DIR}/merged/ukb_merged.bed",
        bim   = f"{OUT_DIR}/merged/ukb_merged.bim",
        fam   = f"{OUT_DIR}/merged/ukb_merged.fam",
        pheno = PHENO_CSV,
        covar = COVAR_FILE
    output:
        kvik = directory(f"{OUT_DIR}/kvik/ukb_merged.kvik")
    threads: 24
    shell:
        r"""
        mkdir -p {OUT_DIR}/kvik

        {LDAK} \
            --kvik-step1 {output.kvik} \
            --bfile {OUT_DIR}/merged/ukb_merged \
            --pheno {input.pheno} \
            --covar {input.covar} \
            --covar-names ALL \
            --mpheno ALL \
            --max-threads {threads}
        """

rule kvik_step2_raw:
    input:
        kvik  = f"{OUT_DIR}/kvik/ukb_merged.kvik",
        pheno = PHENO_FILE,
        covar = COVAR_FILE,
        keep  = ID_LIST
    output:
        expand(
            f"{OUT_DIR}/gwas_raw/assoc.singlesnp.pheno{{i}}",
            i = range(1, len(TRAITS)+1)
        )
    threads: THREADS
    shell:
        r"""
        mkdir -p {OUT_DIR}/gwas_raw

        {LDAK} \
            --kvik-step2 {input.kvik} \
            --pheno {input.pheno} \
            --mpheno ALL \
            --covar {input.covar} \
            --covar-names ALL \
            --keep {input.keep} \
            --max-threads {threads} \
            --out {OUT_DIR}/gwas_raw/assoc.singlesnp
        """

 rule rename_step2_outputs:
    input:
        expand(f"{OUT_DIR}/gwas_raw/assoc.singlesnp.pheno{{i}}",
               i = range(1, len(TRAITS)+1))
    output:
        expand(f"{OUT_DIR}/gwas/{{trait}}/{{trait}}.assoc.singlesnp",
               trait = TRAITS)
    run:
        import os

        for i, trait in enumerate(TRAITS, start=1):
            src = f"{OUT_DIR}/gwas_raw/assoc.singlesnp.pheno{i}"
            dst_dir = f"{OUT_DIR}/gwas/{trait}"
            os.makedirs(dst_dir, exist_ok=True)
            dst = f"{dst_dir}/{trait}.assoc.singlesnp"
            os.rename(src, dst)
