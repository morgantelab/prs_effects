            f"{PRS_CV}/{{trait}}/fold{{fold}}/"
            f"effects/p{{p1}}_r{{r2}}/ad_clumped.txt"
        ),
        test_ids = f"{CV_DIR}" + "/{trait}/test_fold{fold}.keep",
        pheno    = lambda wc: PHENO_FILES[wc.trait],
        bfile_bed = f"{MERGED_BFILE}.bed",
        bfile_bim = f"{MERGED_BFILE}.bim",
