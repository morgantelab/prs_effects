import os
import yaml

configfile: "config.yaml"


OUT_DIR    = config["OUT_DIR"]
CODE_DIR   = config["CODE_DIR"]
PLINK2     = config["PLINK2"]
LDAK       = config["LDAK"]
COVAR_FILE = config["COVARIATES"]

THREADS_PLINK = int(config.get("THREADS_PLINK", 12))
THREADS_R     = int(config.get("THREADS_R", 8))

TRAITS      = config["PHENO_NAMES"]
PHENO_FILES = config["PHENO_FILES"]
KEEP_FILES  = config["KEEP_FILES"]
CHRS        = config.get("CHRS", list(range(1, 23)))

# Existing resources you already have
BASE_FILTERED_PREFIX = config.get(
    "BASE_FILTERED_PREFIX",
    "/data2/morgante_lab/ukbiobank_projects/prs_effects/results/Blood_cell_traits/filtered/ukb_chr"
)


# ========= TARGETS =========
rule all:
    input:
        expand(f"{OUT_DIR}/gwas/{{trait}}/significant.snplist", trait=TRAITS),
        expand(f"{OUT_DIR}/effects/{{trait}}_ad.txt", trait=TRAITS)


# ========= 1) Filter Chromosomes  =========
rule Filter_by_traits_chr:
    input:
        bed  = lambda wc: f"{BASE_FILTERED_PREFIX}{wc.chr}_filtered.bed",
        bim  = lambda wc: f"{BASE_FILTERED_PREFIX}{wc.chr}_filtered.bim",
        fam  = lambda wc: f"{BASE_FILTERED_PREFIX}{wc.chr}_filtered.fam",
        keep = lambda wc: KEEP_FILES[wc.trait]
    output:
        bed = f"{OUT_DIR}/filtered/{{trait}}/ukb_chr{{chr}}_filtered.bed",
        bim = f"{OUT_DIR}/filtered/{{trait}}/ukb_chr{{chr}}_filtered.bim",
        fam = f"{OUT_DIR}/filtered/{{trait}}/ukb_chr{{chr}}_filtered.fam"
    params:
        plink2 = PLINK2,
        inpref = lambda wc: f"{BASE_FILTERED_PREFIX}{wc.chr}_filtered",
        outpref = lambda wc: f"{OUT_DIR}/filtered/{wc.trait}/ukb_chr{wc.chr}_filtered"
    threads: THREADS_PLINK
    shell:
        r"""
        mkdir -p $(dirname {output.bed})

        {params.plink2} \
          --bfile {params.inpref} \
          --keep {input.keep} \
          --make-bed \
          --threads {threads} \
          --out {params.outpref}
        """

rule merge_chromosomes_by_trait:
    input:
        bed = lambda wc: expand(f"{OUT_DIR}/filtered/{wc.trait}/ukb_chr{{chr}}_filtered.bed", chr=CHRS),
        bim = lambda wc: expand(f"{OUT_DIR}/filtered/{wc.trait}/ukb_chr{{chr}}_filtered.bim", chr=CHRS),
        fam = lambda wc: expand(f"{OUT_DIR}/filtered/{wc.trait}/ukb_chr{{chr}}_filtered.fam", chr=CHRS)
    output:
        bed = f"{OUT_DIR}/merged_by_trait/{{trait}}/ukb_merged.bed",
        bim = f"{OUT_DIR}/merged_by_trait/{{trait}}/ukb_merged.bim",
        fam = f"{OUT_DIR}/merged_by_trait/{{trait}}/ukb_merged.fam"
    threads: THREADS_PLINK
    run:
        import os

        out_dir = f"{OUT_DIR}/merged_by_trait/{wildcards.trait}"
        os.makedirs(out_dir, exist_ok=True)

        merge_list = f"{out_dir}/merge_list.txt"

        # plink2 --pmerge-list format: bed bim fam (one chr per line), skipping chr1
        with open(merge_list, "w") as f:
            for c in CHRS[1:]:
                prefix = f"{OUT_DIR}/filtered/{wildcards.trait}/ukb_chr{c}_filtered"
                f.write(f"{prefix}.bed {prefix}.bim {prefix}.fam\n")

        shell(f"""
            {PLINK2} \
              --bfile {OUT_DIR}/filtered/{wildcards.trait}/ukb_chr{CHRS[0]}_filtered \
              --pmerge-list {merge_list} \
              --make-bed \
              --out {OUT_DIR}/merged_by_trait/{wildcards.trait}/ukb_merged
        """)


# ========= 2) GWAS  =========
rule kvik_step1:
    input:
        bed  = f"{OUT_DIR}/merged_by_trait/{{trait}}/ukb_merged.bed",
        bim  = f"{OUT_DIR}/merged_by_trait/{{trait}}/ukb_merged.bim",
        fam  = f"{OUT_DIR}/merged_by_trait/{{trait}}/ukb_merged.fam",
        pheno = lambda wc: PHENO_FILES[wc.trait],
        covar = COVAR_FILE,
        keep  = lambda wc: KEEP_FILES[wc.trait]
    output:
        root     = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step1.root",
        progress = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step1.progress",
        effects  = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step1.effects",
        prs      = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step1.loco.prs",
        details  = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step1.loco.details"
    threads: THREADS_PLINK
    shell:
        r"""
        mkdir -p {OUT_DIR}/kvik/{wildcards.trait}

        {LDAK} \
          --kvik-step1 {OUT_DIR}/kvik/{wildcards.trait}/kvik_output \
          --bfile {OUT_DIR}/merged_by_trait/{wildcards.trait}/ukb_merged \
          --pheno {input.pheno} \
          --covar {input.covar} \
          --mpheno 1 \
          --keep {input.keep} \
          --max-threads {threads}
        """


rule kvik_step2:
    input:
        # step1 outputs (no pheno1)
        root    = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step1.root",
        effects = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step1.effects",
        prs     = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step1.loco.prs",
        details = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step1.loco.details",
        pheno   = lambda wc: PHENO_FILES[wc.trait],
        covar   = COVAR_FILE,
        keep    = lambda wc: KEEP_FILES[wc.trait]
    output:
        assoc     = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step2.assoc",
        summaries = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step2.summaries",
        coeff     = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step2.coeff",
        pvalues   = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step2.pvalues",
        progress  = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step2.progress"
    threads: THREADS_PLINK
    shell:
        r"""
        {LDAK} \
          --kvik-step2 {OUT_DIR}/kvik/{wildcards.trait}/kvik_output \
          --bfile {OUT_DIR}/merged_by_trait/{wildcards.trait}/ukb_merged \
          --pheno {input.pheno} \
          --covar {input.covar} \
          --mpheno 1 \
          --keep {input.keep} \
          --max-threads {threads}
        """

rule gwas_sig_hits:
    input:
        assoc = f"{OUT_DIR}/kvik/{{trait}}/kvik_output.step2.assoc"
    output:
        sig   = f"{OUT_DIR}/gwas/{{trait}}/significant.snplist"
    run:
        import pandas as pd
        os.makedirs(os.path.dirname(output.sig), exist_ok=True)

        df = pd.read_csv(input.assoc, sep=r"\s+")
        thresh = 5e-8
        hits = df[df["Wald_P"] < thresh]
        hits["Predictor"].to_csv(output.sig, index=False, header=False)


# ========= 3) additive and dominance scan =========
rule estimate_ad_real:
    input:
        sig   = f"{OUT_DIR}/gwas/{{trait}}/significant.snplist",
        pheno = lambda wc: PHENO_FILES[wc.trait],
        covar = COVAR_FILE,
        ids   = lambda wc: KEEP_FILES[wc.trait],
        beds  = lambda wc: expand(f"{OUT_DIR}/filtered/{wc.trait}/ukb_chr{{chr}}_filtered.bed", chr=CHRS),
        bims  = lambda wc: expand(f"{OUT_DIR}/filtered/{wc.trait}/ukb_chr{{chr}}_filtered.bim", chr=CHRS),
        fams  = lambda wc: expand(f"{OUT_DIR}/filtered/{wc.trait}/ukb_chr{{chr}}_filtered.fam", chr=CHRS)
    output:
        ad = f"{OUT_DIR}/effects/{{trait}}_ad.txt"
    params:
        script = f"{CODE_DIR}/estimate_effects.R",
        prefix = lambda wc: f"{OUT_DIR}/filtered/{wc.trait}/ukb_chr"
    threads: THREADS_R
    shell:
        r"""
        mkdir -p $(dirname {output.ad})

        module load R/4.2.3

        Rscript {params.script} \
          {params.prefix} \
          {input.sig} \
          {input.ids} \
          {input.pheno} \
          {input.covar} \
          {wildcards.trait} \
          {output.ad}

        module unload R/4.2.3
        """
