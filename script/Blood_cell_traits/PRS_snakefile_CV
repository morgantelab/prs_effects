TRAIT_TO_INDEX = {trait: i for i, trait in enumerate(TRAITS, start=1)}
wildcard_constraints:
    p1=".+", r2=".+"

rule clean_pvalues_for_clump:
    input:
        pvalues = lambda w: (
            f"{OUT_DIR}/kvik_cv/fold{w.fold}/"
            f"kvik_output.step2.pheno{TRAIT_TO_INDEX[w.trait]}.pvalues"
        )
    output:
        clean = (
            f"{PRS_CV}/{{trait}}/fold{{fold}}/"
            f"gwas/pvalues.for_clump.tsv"
        )
    shell:
        r"""
        set -euo pipefail
        mkdir -p $(dirname {output.clean})

        awk '
            NR==1 {{ print; next }}
            ($2 ~ /^[0-9.eE+-]+$/) && ($2 >= 0) && ($2 <= 1) {{ print }}
        ' {input.pvalues} > {output.clean}
        """


rule clump_cv:
    input:
        pvalues = (
            f"{PRS_CV}/{{trait}}/fold{{fold}}/"
            f"gwas/pvalues.for_clump.tsv"
        ),
        keep = f"{CV_DIR}/train_fold{{fold}}.keep"
    output:
        clumped = (
            f"{PRS_CV}/{{trait}}/fold{{fold}}/"
            f"clump/p{{p1}}_r{{r2}}/clumped.clumps"
        )
    params:
        bfile = f"{OUT_DIR}/merged/ukb_merged",
        kb    = CLUMP_KB,
        out_prefix = lambda wc, output: output.clumped.replace(".clumps", "")
    threads: THREADS_PLK
    shell:
        r"""
        mkdir -p $(dirname {output.clumped})

        {PLINK2} \
          --bfile {params.bfile} \
          --keep {input.keep} \
          --clump {input.pvalues} \
          --clump-snp-field Predictor \
          --clump-field P \
          --clump-p1 {wildcards.p1} \
          --clump-r2 {wildcards.r2} \
          --clump-kb {params.kb} \
          --out {params.out_prefix}
        """


rule clumped_snplist:
    input:
        clumped = (
            f"{PRS_CV}/{{trait}}/fold{{fold}}/"
            f"clump/p{{p1}}_r{{r2}}/clumped.clumps"
        )
    output:
        snps = (
            f"{PRS_CV}/{{trait}}/fold{{fold}}/"
            f"clump/p{{p1}}_r{{r2}}/clumped.snplist"
        )
    shell:
        r"""
        awk 'NR>1 && $3!="SNP" {{print $3}}' {input.clumped} | sort -u > {output.snps}
        """

