# ========= 1) Filter bfiles per chromosome =========
rule filter_chr:
    input:
        bed = lambda w: f"{BED_BIM_DIR}/ukb22418_c{w.chr}_b0_v2_s488243.bed",
        bim = lambda w: f"{BED_BIM_DIR}/ukb22418_c{w.chr}_b0_v2_s488243.bim",
        fam = lambda w: f"{FAM_DIR}/ukb22418_c{w.chr}_b0_v2_s487945.fam",
        keep = ID_LIST
    output:
        bed = f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.bed",
        bim = f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.bim",
        fam = f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.fam"
    threads: THREADS_PLK
    params:
        maf = MAF,
        mac = MAC,
        geno = GENO,
        hwe = HWE
    shell:
        r"""
        mkdir -p {OUT_DIR}/filtered

        {PLINK2} \
          --bed {input.bed} \
          --bim {input.bim} \
          --fam {input.fam} \
          --keep {input.keep} \
          --snps-only just-acgt \
          --rm-dup exclude-all \
          --maf {params.maf} \
          --mac {params.mac} \
          --geno {params.geno} \
          --hwe {params.hwe} \
          --threads {threads} \
          --make-bed \
          --out {OUT_DIR}/filtered/ukb_chr{wildcards.chr}_filtered
        """

rule merge_chromosomes:
    input:
        bed = expand(f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.bed", chr=CHRS),
        bim = expand(f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.bim", chr=CHRS),
        fam = expand(f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.fam", chr=CHRS)
    output:
        bed = f"{OUT_DIR}/merged/ukb_merged.bed",
        bim = f"{OUT_DIR}/merged/ukb_merged.bim",
        fam = f"{OUT_DIR}/merged/ukb_merged.fam"
    threads: 20
    run:
        import os

        out_dir = f"{OUT_DIR}/merged"
        os.makedirs(out_dir, exist_ok=True)

        merge_list = f"{out_dir}/merge_list.txt"

        # write plink2 --pmerge-list format (bed bim fam per line)
        with open(merge_list, "w") as f:
            for c in CHRS[1:]:  # skip chr1 as base
                prefix = f"{OUT_DIR}/filtered/ukb_chr{c}_filtered"
                f.write(f"{prefix}.bed {prefix}.bim {prefix}.fam\n")

        # run plink2 parallel merge
        shell(f"""
            {PLINK2} \
                --bfile {OUT_DIR}/filtered/ukb_chr1_filtered \
                --pmerge-list {merge_list} \
                --make-bed \
                --out {OUT_DIR}/merged/ukb_merged
        """)
# ========= 2) create cv_folds  =========
rule make_cv_folds:
    input:
        ids = ID_LIST
    output:
        train = expand(f"{CV_DIR}/train_fold{{fold}}.keep", fold=FOLDS),
        test  = expand(f"{CV_DIR}/test_fold{{fold}}.keep",  fold=FOLDS)
    run:
        import random, os
        os.makedirs(CV_DIR, exist_ok=True)

        rows = []
        with open(input.ids) as f:
            for ln in f:
                if ln.strip():
                    fid, iid, *_ = ln.split()
                    rows.append((fid, iid))

        random.seed(CV_SEED)
        random.shuffle(rows)

        n = len(rows)
        sizes = [n // N_FOLDS] * N_FOLDS
        for i in range(n % N_FOLDS):
            sizes[i] += 1

        folds = []
        idx = 0
        for s in sizes:
            folds.append(rows[idx:idx+s])
            idx += s

        for k in range(1, N_FOLDS + 1):
            test_rows  = folds[k-1]
            train_rows = [r for j,f in enumerate(folds) if j != k-1 for r in f]

            with open(f"{CV_DIR}/test_fold{k}.keep", "w") as f:
                for fid, iid in test_rows:
                    f.write(f"{fid}\t{iid}\n")

            with open(f"{CV_DIR}/train_fold{k}.keep", "w") as f:
                for fid, iid in train_rows:
                    f.write(f"{fid}\t{iid}\n")


