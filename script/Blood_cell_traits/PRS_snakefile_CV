        bfile_prefix = f"{OUT_DIR}/filtered/ukb_chr"
    threads: THREADS_R
    shell:
        r"""
        mkdir -p $(dirname {output.ad})
        module load R/4.2.3

        Rscript {params.script} \
          {params.bfile_prefix} \
