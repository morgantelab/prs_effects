rule make_beta_weights_clumped:
    input:
        assoc = lambda w: (
            f"{OUT_DIR}/kvik_cv/fold{w.fold}/"
            f"kvik_output.step2.pheno{TRAIT_TO_INDEX[w.trait]}.assoc"
        ),
        snps = (
            f"{PRS_CV}/{{trait}}/fold{{fold}}/"
            f"clump/p{{p1}}_r{{r2}}/clumped.snplist"
        )
    output:
        weights = (
            f"{PRS_CV}/{{trait}}/fold{{fold}}/"
            f"score/p{{p1}}_r{{r2}}/beta_for_score.clumped.txt"
        )
    shell:
        r"""
        mkdir -p $(dirname {output.weights})

        awk 'BEGIN{{FS=OFS="\t"}}
            NR==FNR {{snps[$1]=1; next}}
            FNR==1  {{next}}
            ($2 in snps) && !seen[$2]++ {{print $2, $4, $8}}' \
            {input.snps} {input.assoc} \
        > {output.weights}
        """

rule score_prs_beta_cv:
    input:
        weights  = (
            f"{PRS_CV}/{{trait}}/fold{{fold}}/"
            f"score/p{{p1}}_r{{r2}}/beta_for_score.clumped.txt"
        ),
        test_ids = f"{CV_DIR}/test_fold{{fold}}.keep",
        bfile_bed = f"{OUT_DIR}/merged/ukb_merged.bed",
        bfile_bim = f"{OUT_DIR}/merged/ukb_merged.bim",
        bfile_fam = f"{OUT_DIR}/merged/ukb_merged.fam"
    output:
        sscore = (
            f"{PRS_CV}/{{trait}}/fold{{fold}}/"
            f"score/p{{p1}}_r{{r2}}/score_beta_clumped.sscore"
        )
    params:
        bfile_pref = f"{OUT_DIR}/merged/ukb_merged",
        outprefix  = (
            f"{PRS_CV}/{{trait}}/fold{{fold}}/"
            f"score/p{{p1}}_r{{r2}}/score_beta_clumped"
        )
    threads: 4
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {params.outprefix})"

        if [ "$(wc -l < "{input.weights}")" -le 1 ]; then
          awk 'BEGIN{{OFS="\t"; print "IID","BETA_SUM"}} {{print $2,0}}' \
              {input.test_ids} > "{output.sscore}"
        else
          {PLINK2} \
            --bfile {params.bfile_pref} \
            --keep {input.test_ids} \
            --score {input.weights} 1 2 3 cols=+scoresums \
            --out {params.outprefix}
        fi
        """


