configfile: "GWAS_config.yaml"

wildcard_constraints:
    CHR = "|".join(map(str, config["CHR"])),
    REP = "|".join(map(str, config["REP"]))

# Define final outputs
rule all:
    input:
        

# Rule to run GWAS per chromosome
rule GWAS:
    input:
        bfile = expand("{geno_dir}/ukb_chr{chr}_filtered.{ext}",
                          geno_dir=config["geno_dir"],
                          chr=config["CHR"],
                          ext=["bed", "bim", "fam"]),
        pheno = config["results_dir"] + "/" + "simulated_pheno_rep{REP}.txt",
        train_ids = config["results_dir"] + "/" + "training_ID_rep{REP}.txt"
    output:
        gwas_out = expand("{gwas_dir}/gwas_rep{REP}_chr{chr}.pheno.glm.linear",
                        gwas_dir = config["gwas_dir"],
                        chr = config["CHR"],
                        REP = config["REP"])
    threads: 40
    params:
        out_prefix = config["gwas_dir"] + "/" + "gwas_rep{REP}_chr",
        plink2 = config["plink2_path"],
        CODE = config["code_dir"] + "/" + "run_gwas.R",
        rep = "{REP}",
        results_dir = config["results_dir"]
        geno_pattern = config["geno_dir"] + "/"+ "ukb_chr"
    shell:
        """
        module load R/4.2.3
        export MKL_NUM_THREADS={threads}
        
        Rscript {params.CODE} \
                {params.rep} \
                {params.results_dir} \
                {input.train_ids} \
                {input.pheno} \
                {params.output_prefix} \
                {params.plink2} \
                {params.geno_pattern}
           
        module unload R/4.2.3
        """

# Rule to perform clumping per chromosome and LD threshold
rule clumping:
    input:
        bfile = expand("{geno_dir}/ukb_chr{chr}_filtered.{ext}",
                     geno_dir=config["geno_dir"],
                     chr=config["CHR"],
                     ext=["bed", "bim", "fam"]),
        gwas = expand("{gwas_dir}/gwas_rep{rep}_chr{chr}.pheno.glm.linear",
                    gwas_dir=config["gwas_dir"],
                    chr=config["CHR"],
                    rep=config["REP"]),
        train_ids = config["results_dir"] + "/training_ID_rep{rep}.txt"
    output:
        clump_out = expand("{gwas_dir}/gwas_clump_rep{rep}_chr{chr}_r2{r2}.clumps",
                         gwas_dir=config["gwas_dir"],
                         chr=config["CHR"],
                         rep=config["REP"],
                         r2=[f"{x:.1f}" for x in config["LD_THRESHOLDS"]]),
        snplist = expand("{gwas_dir}/gwas_clump_rep{rep}_chr{chr}r2{r2}.snplist",
                       gwas_dir=config["gwas_dir"],
                       chr=config["CHR"],
                       rep=config["REP"],
                       r2=[f"{x:.1f}" for x in config["LD_THRESHOLDS"]])
    params:
        out_prefix = lambda wildcards: f"{config['gwas_dir']}/gwas_clump_rep{wildcards.rep}_r2_chr",
        plink2 = config["plink2_path"],
        p_threshold = config["P_THRESHOLD"],
        LD_THRESHOLDS = ",".join([f"{x:.1f}" for x in config["LD_THRESHOLDS"]]),
        CODE = config["code_dir"] + "/" +"run_clumping.R",
        geno_pattern = config["geno_dir"] + "/" + "ukb_chr",
        gwas_pattern = config["gwas_dir"] + "/" + "gwas_rep{REP}_chr",
        rep = "{REP}"
    threads: 40
    shell:
        """
        module load R/4.2.3
        export MKL_NUM_THREADS={threads}
        
        Rscript {params.CODE} \
                {params.geno_pattern} \
                {params.gwas_pattern} \
                {input.train_ids} \
                {params.out_prefix} \
                {params.plink2} \
                {params.p_threshold} \
                {params.LD_thresholds}
                
        module unload R/4.2.3
        """

# Rule to calculate PRS for test set
rule calculate_prs_test:
    input:
        bfile = expand("{geno_dir}/ukb_chr{chr}_filtered.{ext}",
                     geno_dir=config["geno_dir"],
                     chr=config["CHR"],
                     ext=["bed", "bim", "fam"]),
        gwas = expand("{gwas_dir}/gwas_rep{rep}_chr{chr}.pheno.glm.linear",
                    gwas_dir=config["gwas_dir"],
                    chr=config["CHR"],
                    rep=config["REP"]),
        clump = expand("{gwas_dir}/gwas_clump_rep{rep}_chr{chr}_r2{r2}.snplist",
                      gwas_dir=config["gwas_dir"],
                      chr=config["CHR"],
                      rep=config["REP"],
                      r2=[f"{x:.1f}" for x in config["LD_THRESHOLDS"]]),
        test_ids = config["results_dir"] + "/test_ID_rep{REP}.txt"
    output:
        prs_out = config["results_dir"] + "/" + "test_prs_gwas_rep{REP}.txt"
    params:
        out_prefix = lambda wildcards: f"{config['gwas_dir']}/test_prs_gwas_rep{wildcards.REP}",
        plink2 = config["plink2_path"],
        ld_thresholds = ",".join([f"{x:.1f}" for x in config["LD_THRESHOLDS"]]),
        CODE = config["code_dir"] + "/calculate_prs.R",
        geno_pattern = config["geno_dir"] + "/ukb_chr",
        gwas_pattern = config["gwas_dir"] + "/gwas_rep{rep}_chr",
        clump_pattern = config["gwas_dir"] + "/gwas_clump_rep{rep}_chr",
        results_dir = config["results_dir"],
        rep = "{REP}"
    threads: 40
    shell:
        """
        module load R/4.2.3
        export MKL_NUM_THREADS={threads}
        
        Rscript {params.CODE} \
                {params.geno_pattern} \
                {params.gwas_pattern} \
                {params.clump_pattern} \
                {input.test_ids} \
                {params.out_prefix} \
                {params.plink2} \
                {params.ld_thresholds} \
                {params.results_dir} \
                {params.rep}
                
        module unload R/4.2.3
        """