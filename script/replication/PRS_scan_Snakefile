    input:
        bfile = lambda wildcards: [
            f"{config['pheno_dir']}/ukb_chr{wildcards.CHR}_filtered.{ext}" 
            for ext in ["bed", "bim", "fam"]
        ],
        gwas = "{results_dir}/gwas/gwas_rep{REP}_chr{CHR}.pheno.glm.linear",
        train_ids = config["pheno_dir"] + "/training_ID_rep{REP}.txt"
    output:
        clump_out = "{results_dir}/clumping/{p}/gwas_clump_rep{REP}_chr{CHR}_r2_{r2}.clumps",
        snplist = "{results_dir}/clumping/{p}/gwas_clump_rep{REP}_chr{CHR}_r2_{r2}.snplist"
    params:
        out_prefix = "{results_dir}/clumping/{p}/gwas_clump_rep{REP}_chr{CHR}_r2_{r2}",
        plink2 = config["plink2_path"],
        p_threshold = lambda wildcards: wildcards.p,
        clump_kb = config["CLUMPING_KB"],
        clump_dir = config["results_dir"] + "/clumping/{p}"
    threads: 10
    resources:
        mem_mb = 10000,
        time = "24:00:00",
        partition = 'fm-bigmem-3'
    shell:
        r"""
        mkdir -p {params.clump_dir}
        
        {params.plink2} \
            --bfile $(echo {input.bfile[0]} | sed 's/\.bed$//') \
            --clump {input.gwas} \
            --clump-p1 {params.p_threshold} \
            --clump-r2 {wildcards.r2} \
            --clump-kb {params.clump_kb} \
            --keep {input.train_ids} \
            --out {params.out_prefix}
        
        if [ -f "{params.out_prefix}.clumps" ]; then
            awk 'NR > 1 {{print $3}}' "{params.out_prefix}.clumps" > "{output.snplist}"
        else
            echo "No clumped SNPs found" > "{output.snplist}"
        fi
        """

