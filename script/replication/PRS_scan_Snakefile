rule GWAS:
    input:
        bed = config["pheno_dir"] + "/ukb_chr{CHR}_filtered.bed",
        bim = config["pheno_dir"] + "/ukb_chr{CHR}_filtered.bim",
        fam = config["pheno_dir"] + "/ukb_chr{CHR}_filtered.fam",
        pheno = config["pheno_dir"] + "/simulated_pheno_rep{REP}.txt",  # Fixed typo in "simulated"
        train_ids = config["pheno_dir"] + "/training_ID_rep{REP}.txt"
    output:
        gwas_out = config["results_dir"] + "/gwas/gwas_rep{REP}_chr{CHR}.pheno.glm.linear"
    params:
        out_prefix = lambda wildcards: config["results_dir"] + f"/gwas/gwas_rep{wildcards.REP}_chr{wildcards.CHR}",
        plink2 = config["plink2_path"],
        geno_prefix = lambda wildcards: config["pheno_dir"] + f"/ukb_chr{wildcards.CHR}_filtered",
        train_pheno = lambda wildcards: config["results_dir"] + f"/gwas/train_pheno_rep{wildcards.REP}.txt",
        gwas_dir = config["results_dir"] + "/gwas"
    threads: 20
    resources:
        mem_mb = 100000,
        time = "24:00:00"
    shell:
        """
        # Create GWAS directory if needed
        mkdir -p {params.gwas_dir}
        
        # Create training phenotype file for rep {wildcards.REP}
        echo "Creating training phenotype file"
        awk 'BEGIN {{OFS="\\t"}} NR==FNR {{ids[$1]=1; next}} FNR==1 {{print "FID","IID","pheno"}} $2 in ids {{print $1,$2,$3}}' \
            {input.train_ids} {input.pheno} > {params.train_pheno}
        
        # Run PLINK2 for GWAS on chromosome {wildcards.CHR}
        {params.plink2} \
            --bfile {params.geno_prefix} \
            --pheno {params.train_pheno} \
            --keep {input.train_ids} \
            --glm no-x-sex allow-no-covars \
            --no-input-missing-phenotype \
            --pheno-name pheno \
            --out {params.out_prefix} \
            --threads {threads}
        """


rule clumping:
    input:
        bfile = lambda wildcards: [
            f"{config['pheno_dir']}/ukb_chr{wildcards.CHR}_filtered.{ext}" 
            for ext in ["bed", "bim", "fam"]
        ],
        gwas = "{results_dir}/gwas/gwas_rep{REP}_chr{CHR}.pheno.glm.linear",
        train_ids = "{results_dir}/pheno/training_ID_rep{REP}.txt"
    output:
        clump_out = "{results_dir}/clumping/{p}/gwas_clump_rep{REP}_chr{CHR}_r2_{r2}.clumps",
        snplist = "{results_dir}/clumping/{p}/gwas_clump_rep{REP}_chr{CHR}_r2_{r2}.snplist"
    params:
        out_prefix = "{results_dir}/clumping/{p}/gwas_clump_rep{REP}_chr{CHR}_r2_{r2}",
        plink2 = config["plink2_path"],
        p_threshold = lambda wildcards: float(wildcards.p),  # e.g., "1e-3" → 0.001
        clump_kb = config["CLUMPING_KB"],
        clump_dir = config["results_dir"] + "/clumping/{p}"
    threads: 10
    resources:
        mem_mb = 100000,
        time = "24:00:00",
        partition = 'fm-bigmem-3'
    shell:
        """
        # Create output directory
        mkdir -p {params.clump_dir}
        
        # Run PLINK2 clumping
        {params.plink2} \\
            --bfile $(echo {input.bfile[0]} | sed 's/\\.bed$//') \\
            --clump {input.gwas} \\
            --clump-p1 {params.p_threshold} \\
            --clump-r2 {wildcards.r2} \\
            --clump-kb {params.clump_kb} \\
            --keep {input.train_ids} \\
            --out {params.out_prefix}
        
        # Extract SNP list from clumps file
        if [ -f "{params.out_prefix}.clumps" ]; then
            awk 'NR > 1 {{print $3}}' "{params.out_prefix}.clumps" > "{output.snplist}"
        else
            echo "No clumped SNPs found" > "{output.snplist}"
        fi
        """

