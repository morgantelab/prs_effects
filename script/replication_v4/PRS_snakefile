# ========= 1) Filter bfiles per chromosome (shared for all scenarios) =========
rule filter_chr:
    input:
        bed = lambda wild: f"{BED_BIM_DIR}/ukb22418_c{wild.chr}_b0_v2_s488243.bed",
        bim = lambda wild: f"{BED_BIM_DIR}/ukb22418_c{wild.chr}_b0_v2_s488243.bim",
        fam = lambda wild: f"{FAM_DIR}/ukb22418_c{wild.chr}_b0_v2_s487945.fam",
        keep = f"{OUT_DIR}/ID_filtered.txt"
    output:
        bed = f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.bed",
        bim = f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.bim",
        fam = f"{OUT_DIR}/filtered/ukb_chr{{chr}}_filtered.fam"
    params:
        maf = config["MAF"],
        mac = config["MAC"],
        geno= config["GENO"],
        hwe = config["HWE"],
        threads = THREADS_PLK
    threads: THREADS_PLK
    shell:
        r"""
        {PLINK2} \
          --bed {input.bed} \
          --bim {input.bim} \
          --fam {input.fam} \
          --keep {input.keep} \
          --rm-dup exclude-all \
          --snps-only just-acgt \
          --maf {params.maf} \
          --mac {params.mac} \
          --geno {params.geno} \
          --hwe {params.hwe} \
          --threads {threads} \
          --make-bed \
          --out {OUT_DIR}/filtered/ukb_chr{wildcards.chr}_filtered
        """

# convenience aggregate
