configfile: "config.yaml"

# Define directories from config
base_dir = config["base_dir"]
results_dir = config["results_dir"]
plink2_path = config["plink2_path"]
log_dir = config["log_dir"]
error_dir = config["error_dir"]
cluster_cmd = config["cluster"]
code_dir = config["code_dir"]
fam_dir = config["fam_dir"]
geno_dir = config["geno_dir"]

# Create chromosome effects directory
chr_dir = f"{results_dir}/chr_effects"
final_output = f"{results_dir}/effect_size_large_test_200k.txt"

rule all:
    input:
        final_output  # Require the final combined output
        
rule sample_selection:
    input:
        fam = f"{fam_dir}/ukb22418_c1_b0_v2_s487945.fam"
    output:
        sample = f"{results_dir}/ID_filtered.txt"
    shell:
        r"""
        module load R/4.2.3
        Rscript {code_dir}/sample_ini_selection.R \
            {input.fam} \
            {output.sample}        
        """
        
rule sample_geno_filtering:
    input:
        id_file = f"{results_dir}/ID_filtered.txt",
        bed = lambda wc: f"{BED_BIM_DIR}/ukb22418_c{wildcards.chrom}_b0_v2_s488243.bed",
        bim = lambda wc: f"{BED_BIM_DIR}/ukb22418_c{wildcards.chrom}_b0_v2_s488243.bim",
        fam = lambda wc: f"{FAM_DIR}/ukb22418_c{wildcards.chrom}_b0_v2_s487945.fam"
    output:
        bed = f"{geno_dir}/ukb_chr{chrom}_filtered.bed",
        bim = f"{geno_dir}/ukb_chr{chrom}_filtered.bim",
        fam = f"{geno_dir}/ukb_chr{chrom}_filtered.bim",
        afreq = "{output_dir}/ukb_chr{chrom}_filtered.afreq",
        log = "{output_dir}/ukb_chr{chrom}_filtered.log"
    params:
        prefix = "{output_dir}/ukb_chr{chrom}_filtered",
        plink2 = plink2_path
    threads: 8
    shell:
        """
        # Step 1: Filter samples/variants and create new PLINK files
        {params.plink2} \
            --bed {input.bed} \
            --bim {input.bim} \
            --fam {input.fam} \
            --keep {input.id_file} \
            --rm-dup exclude-all \
            --snps-only just-acgt \
            --maf 0.01 \
            --mac 5 \
            --geno 0.1 \
            --hwe 1e-5 \
            --threads 4 \
            --make-bed \
            --out {params.prefix} > {output.log} 2>&1
        
        # Step 2: Calculate allele frequencies
        {params.plink2} \
            --bfile {params.prefix} \
            --freq \
            --out {params.prefix} >> {output.log} 2>&1
        """

rule pheno_simulation:
    input:
        # Input frequency files for all chromosomes
        freq_files = expand("{base_dir}/ukb_chr{chrom}_filtered_200k.afreq", chrom=range(1, 23)),
        # Input PLINK files for all chromosomes
        plink_files = expand("{base_dir}/ukb_chr{chrom}_filtered_200k.{ext}", 
                            chrom=range(1, 23), 
                            ext=["bed", "bim", "fam"])
    output:
        pheno = "{results_dir}/simulated_pheno_rep{rep}.txt",
        geno = "{results_dir}/simulated_geno_rep{rep}.txt",
        causal_snps = "{results_dir}/causal_snps_rep{rep}.txt"
    params:
        rep = "{rep}",  # Wildcard for replicate number
        seed = lambda wildcards: 1000 + int(wildcards.rep),  # Unique seed per replicate
    log:
        "logs/pheno_sim_rep{rep}.log"  # Log file per replicate
    threads: 8  # Threads for PLINK operations
    envvars:
        PLINK2 = config["plink2_path"]  # Path to plink2 from config
    shell:
        r"""
        module load R/4.2.3
        Rscript {code_dir}/estimate_effects.R \
            {params.rep} \
            {params.seed} \
            {geno_dir} \
            {results_dir}
        """

rule estimate_effects:
    input:
        pheno = f"{results_dir}/simulated_phenorep{rep}.txt"
    output:
        chr_effects = f"{results_dir}/chr_effects/chr{chrom}/rep{rep}.txt"
    shell:
        r"""
        module load R/4.2.3
        Rscript {code_dir}/estimate_effects.R \
            {input.pheno} \
            {output.chr_effects} \
            {wildcards.chrom}
        """

rule combine_results:
    input:
        # List all chromosome files using the same pattern as process_chromosome
        expand(f"{results_dir}/chr_effects/chr{chrom}/rep{rep}.txt", chrom=list(range(1, 23)))
    output:
        combined_effecs = 
    shell:
        r"""
        module load R/4.2.3
        Rscript {code_dir}/combined_results.R \
            {chr_dir} \
            {output}
        """
        
