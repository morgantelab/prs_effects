configfile: "config.yaml"

# Define directories from config
base_dir = config["base_dir"]
results_dir = config["results_dir"]
plink2_path = config["plink2_path"]
log_dir = config["log_dir"]
error_dir = config["error_dir"]
cluster_cmd = config["cluster"]
code_dir = config["code_dir"]
fam_dir = config["fam_dir"]
geno_dir = config["geno_dir"]
BED_BIM_DIR = config["bed_bim_dir"]  

# Create chromosome effects directory
chr_dir = f"{results_dir}/chr_effects"
chromosomes = list(range(1, 23))
replicates = list(range(1, 21))

rule all:
    input:
        expand(f"{results_dir}/simulated_pheno_rep{{rep}}.txt", rep=replicates),
        expand(f"{results_dir}/combined_effects_rep{{rep}}.txt", rep=replicates)
        
rule sample_selection:
    input:
        fam = f"{fam_dir}/ukb22418_c1_b0_v2_s487945.fam"
    output:
        sample = f"{results_dir}/ID_filtered.txt"
    shell:
        r"""
        module load R/4.2.3
        Rscript {code_dir}/sample_ini_selection.R \
            {input.fam} \
            {output.sample}        
        """
        
rule sample_geno_filtering:
    input:
        id_file = f"{results_dir}/ID_filtered.txt",
        bed = lambda wildcards: f"{BED_BIM_DIR}/ukb22418_c{wildcards.chrom}_b0_v2_s488243.bed",
        bim = lambda wildcards: f"{BED_BIM_DIR}/ukb22418_c{wildcards.chrom}_b0_v2_s488243.bim",
        fam = lambda wildcards: f"{fam_dir}/ukb22418_c{wildcards.chrom}_b0_v2_s487945.fam"
    output:
        bed = f"{geno_dir}/ukb_chr{{chrom}}_filtered.bed",
        bim = f"{geno_dir}/ukb_chr{{chrom}}_filtered.bim",
        fam = f"{geno_dir}/ukb_chr{{chrom}}_filtered.fam",
        afreq = f"{geno_dir}/ukb_chr{{chrom}}_filtered.afreq"
    params:
        prefix = lambda wildcards: f"{geno_dir}/ukb_chr{wildcards.chrom}_filtered",
        plink2 = plink2_path
    shell:
        """
        {params.plink2} \
            --bed {input.bed} \
            --bim {input.bim} \
            --fam {input.fam} \
            --keep {input.id_file} \
            --rm-dup exclude-all \
            --snps-only just-acgt \
            --maf 0.01 \
            --mac 5 \
            --geno 0.1 \
            --hwe 1e-5 \
            --threads 4 \
            --make-bed \
            --out {params.prefix}
        
        {params.plink2} \
            --bfile {params.prefix} \
            --freq \
            --out {params.prefix}
        """

rule pheno_simulation:
    input:
        freq_files = expand(f"{geno_dir}/ukb_chr{{chrom}}_filtered.afreq", chrom=chromosomes),
        plink_files = expand(f"{geno_dir}/ukb_chr{{chrom}}_filtered.{{ext}}", 
                            chrom=chromosomes, 
                            ext=["bed", "bim", "fam"])
    output:
        pheno = f"{results_dir}/simulated_pheno_rep{{rep}}.txt",
        geno = f"{results_dir}/simulated_geno_rep{{rep}}.txt",
        causal_snps = f"{results_dir}/causal_snps_rep{{rep}}.txt"
    params:
        rep = "{rep}",  # Wildcard for replicate number
        seed = lambda wildcards: 1000 + int(wildcards.rep),  # Unique seed per replicate
    shell:
        r"""
        module load R/4.2.3
        Rscript {code_dir}/pheno_simulation.R \
            {params.rep} \
            {params.seed} \
            {geno_dir} \
            {results_dir}
        """
        
rule estimate_effects:
    input:
        pheno = f"{results_dir}/simulated_pheno_rep{{rep}}.txt"
    output:
        chr_effects = f"{results_dir}/chr_effects/chr{{chrom}}_rep{{rep}}.txt",
        train_ID = f"{results_dir}/training_ID_rep{{rep}}.txt",
        test_ID = f"{results_dir}/test_ID_rep{{rep}}.txt"
    params:
        rep = "{rep}",
        chrom = "{chrom}",
        seed = lambda wildcards: 1000 + int(wildcards.rep)
    shell:
        r"""
        module load R/4.2.3
        Rscript {code_dir}/estimate_effects.R \
            {input.pheno} \
            {output.chr_effects} \
            {geno_dir} \
            {params.chrom} \
            {params.rep} \
            {output.train_ID} \
            {output.test_ID}
        """
        
rule combine_results:
    input:
        expand(f"{results_dir}/chr_effects/chr{{chrom}}_rep{{rep}}.txt", chrom=list(range(1, 23)), rep=range(1, 21))
    output:
        combined_effects = f"{results_dir}/combined_effects_rep{{rep}}.txt"
    params:
        chr_dir = chr_dir,
        rep = "{rep}"
    shell:
        r"""
        module load R/4.2.3
        Rscript {code_dir}/combined_effects.R \
            {params.chr_dir} \
            {output.combined_effects} \
            {params.rep}
        """